PORT=4000
USE_MOCK_ML=true

# Selects the ML adapter used by backend/ml/mlClient.js: "mock" | "python" | "onnx".
# Defaults to "mock" when unset. "onnx" is a documented stub, not implemented.
ML_ADAPTER=mock

# Python executable used by the "python" adapter (defaults to "python3" on
# POSIX, "python" on Windows).
# PYTHON_BIN=python
